<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The host's half of screen sharing (README, host requirement 5). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- The host's ringing: a call answered on the lock screen opens the call screen through a full-screen intent. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".SampleApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- So `perfetto` can sample the release build, which is the one worth measuring. -->
        <profileable android:shell="true" />

        <!-- The orientation changes handled in place, so a scenario's rotation keeps its state. -->
        <activity
            android:name=".SampleActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The library declares microphone|camera; the host adds the Play-reviewed type when it shares the screen. -->
        <service
            android:name="io.element.android.call.impl.services.ElementCallForegroundService"
            android:foregroundServiceType="mediaProjection"
            tools:node="merge" />
    </application>

</manifest>
