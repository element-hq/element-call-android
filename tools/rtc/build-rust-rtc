set -e
set -u

# Usage:
#
# ./tools/rtc/build-rust-rtc [--rtc PATH] [--slim]
#
# Builds matrix-rust-rtc and publishes it to the local Maven repository as
# io.element.android:matrix-rtc-android:0.0.0-local; build here with -PmatrixRtcLocalVersion=0.0.0-local
# (see docs/local_stack.md, layer 1).
#
# Prerequisites (see mobile/PACKAGING.md in matrix-rust-rtc):
#   cargo install uniffi_bindgen cargo-ndk
#   rustup target add aarch64-linux-android armv7-linux-androideabi x86_64-linux-android
#   ANDROID_NDK_HOME (or ANDROID_HOME/ndk/<version>)

## Defaults

rtcPath="../matrix-rust-rtc"
media=1

while [ $# -gt 0 ]; do
    case "$1" in
        '--rtc')
            rtcPath="$2"
            shift 2
        ;;
        '--slim')
            # Signalling only: much faster to build, but no frame streams or publishing.
            media=0
            shift
        ;;
        '-h'|'--help')
            echo "Usage: $0 [--rtc PATH] [--slim]"
            exit 0
        ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 1
        ;;
    esac
done

if [ ! -d "${rtcPath}" ]; then
    echo "matrix-rust-rtc not found at ${rtcPath}. Clone it or pass --rtc PATH." >&2
    exit 1
fi

pushd "${rtcPath}" > /dev/null

if [ "${media}" -eq 1 ]; then
    make build-android-media
else
    ./scripts/build-android-aar.sh
fi

publishArgs=(-PmatrixRtcVersion=0.0.0-local)
if [ "${media}" -eq 1 ]; then
    publishArgs+=(-PmatrixRtcMedia=true)
fi
(cd mobile/android && ./gradlew :matrixrtc:publishReleasePublicationToMavenLocal "${publishArgs[@]}")
popd > /dev/null

echo "Published io.element.android:matrix-rtc-android:0.0.0-local to ~/.m2. Build with -PmatrixRtcLocalVersion=0.0.0-local."
