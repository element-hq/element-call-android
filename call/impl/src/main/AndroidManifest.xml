<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Neither is required: a device with no camera can still take part in a call, audio only. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!--
      ~ No Activity of its own, deliberately. The call is drawn inside the host's own Compose tree
      ~ (ElementCallOverlay), which is what lets it minimize into a bar above the host's content instead
      ~ of only ever being a full-screen window in a separate task.
      -->
    <application>
        <!--
          ~ Both types declared, but the service only ever starts with the ones whose permission has
          ~ actually been granted - startForeground throws otherwise, and the camera is asked for
          ~ lazily, mid-call. See ElementCallForegroundService.
          ~
          ~ Screen sharing needs the `mediaProjection` type too. It is Play-reviewed and a library
          ~ manifest merges into every host, so the host declares it, with its permission, when it turns
          ~ screen sharing on with `ElementCallOptions.isScreenSharingEnabled` (README, host requirements):
          ~ `tools:node="merge"` lets the two declarations combine.
          -->
        <service
            android:name=".services.ElementCallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera"
            tools:node="merge" />

        <!--
          ~ The ongoing-call notification's Hang up and Mute buttons. Not exported: only our own
          ~ PendingIntents fire it, and an exported receiver would let any app on the device end a
          ~ call.
          -->
        <receiver
            android:name=".receivers.ElementCallActionReceiver"
            android:exported="false" />
    </application>

</manifest>
