<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          ~ Its own task, so it alone shows over the lock screen and shrinks into picture-in-picture while
          ~ the host's Activity stays usable. Out of Recents: the call is reached from the bar, the
          ~ notification or the picture-in-picture window.
          -->
        <activity
            android:name=".ElementCallActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:taskAffinity="${applicationId}.call"
            android:theme="@style/Theme.ElementCall.CallScreen" />
    </application>

</manifest>
