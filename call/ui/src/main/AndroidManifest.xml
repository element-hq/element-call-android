<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          ~ In the host's task, on top of its Activity, so minimizing into picture-in-picture leaves the
          ~ host's Activity already under the window. It alone shows over the lock screen. Out of Recents
          ~ when it is all there is of a task: the call is reached from the bar, the notification or the
          ~ picture-in-picture window.
          -->
        <activity
            android:name=".ElementCallActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.ElementCall.CallScreen" />
    </application>

</manifest>
